{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taikan-quiz.schema.json",
  "title": "體感闖關問答 題庫（taikan-quiz v1）",
  "description": "說明見 docs/quiz.md「題庫格式」與 docs/quiz-ai.md。遊戲讀檔時比這份規格寬鬆（例如 answer 也接受選項文字、題型也接受中文名稱），這份是建議 AI 工具輸出的嚴格格式。",
  "type": "object",
  "required": ["format", "version", "title", "questions"],
  "properties": {
    "format": { "const": "taikan-quiz" },
    "version": { "const": 1 },
    "id": { "type": "string" },
    "title": { "type": "string", "maxLength": 40 },
    "subject": { "type": "string" },
    "grade": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string", "description": "教材來源與授權" },
    "note": { "type": "string" },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["name", "data"],
        "properties": { "name": { "type": "string" }, "data": { "type": "string", "pattern": "^data:image/" } }
      }
    }
  },
  "$defs": {
    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 40 },
        { "type": "object", "properties": { "text": { "type": "string" }, "image": { "$ref": "#/$defs/image" } } }
      ]
    },
    "image": { "type": "string", "description": "art:<種類>:<值>（內建圖庫）、img:<id>（本檔 images）或上傳時的檔名" },
    "common": {
      "type": "object",
      "properties": {
        "q": { "type": "string", "maxLength": 200 },
        "hint": { "type": "string" },
        "explain": { "type": "string" },
        "difficulty": { "enum": [1, 2, 3] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "$ref": "#/$defs/image" }
      }
    },
    "question": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": ["type", "q"],
      "oneOf": [
        { "properties": { "type": { "enum": ["choice", "image"] }, "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/item" } }, "answer": { "enum": ["A", "B", "C", "D"] } }, "required": ["options", "answer"] },
        { "properties": { "type": { "const": "tf" }, "answer": { "enum": ["○", "×"] } }, "required": ["answer"] },
        { "properties": { "type": { "const": "order" }, "items": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/item" } } }, "required": ["items"] },
        { "properties": { "type": { "const": "match" }, "pairs": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/item" } } } }, "required": ["pairs"] },
        { "properties": { "type": { "const": "number" }, "answer": { "type": "number" }, "options": { "type": "array", "maxItems": 3, "items": { "type": "number" } }, "unit": { "type": "string" } }, "required": ["answer"] }
      ]
    }
  }
}
